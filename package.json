{
	"name": "readr",
	"private": true,
	"engines": {
		"npm": ">=10.9.2",
		"node": ">=24"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"build:apps": "pnpm --filter @boilerplate/auth run build",
		"build:packages": "pnpm --filter @boilerplate/shared run build && pnpm --filter @boilerplate/logger run build && pnpm --filter @boilerplate/telemetry run build && pnpm --filter @boilerplate/validation run build",
		"build": "pnpm run build:packages && pnpm run build:apps",
		"dev": "concurrently -n auth -c blue \"pnpm --filter @boilerplate/auth dev\"",
		"format": "biome format --fix .",
		"lint": "pnpm run --parallel lint",
		"lint:fix": "pnpm run --parallel lint:fix",
		"test": "pnpm run --parallel test",
		"typeCheck": "pnpm run --parallel typeCheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@boilerplate/biome": "workspace:*",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/node": "catalog:",
		"concurrently": "10.0.5",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"rimraf": "catalog:",
		"tsx": "4.23.13",
		"typescript": "catalog:"
	}
}
