{
	"name": "@boilerplate/validation",
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=20.18.1"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --build --watch",
		"typeCheck": "tsc --noEmit",
		"lint": "biome check ./src",
		"lint:fix": "biome check --fix ./src",
		"clean": "rimraf ./dist"
	},
	"dependencies": {
		"@boilerplate/shared": "workspace:*",
		"@boilerplate/logger": "workspace:*"
	},
	"devDependencies": {
		"@boilerplate/tsconfig": "workspace:*",
		"rimraf": "catalog:"
	}
}
