# Extension environment
# Copy this file to .env.local before building the extension.

# Primary AI provider for summaries and chat. Both values are required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional fallback. It is also used as the primary provider when OpenRouter is unset.
NVIDIA_API_KEY=

# Read-aloud API provided by the web app. Keep the app running on port 3030.
EDGE_TTS_API_URL=http://localhost:3030/api/tts
