{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "readr",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Forks: these point at the maintainer's resources. Create your own with
	// `wrangler d1 create readr-db` and `wrangler r2 bucket create <name>`, then replace
	// database_id and bucket_name below (see README "Deploy your own").
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "readr-db",
			"database_id": "9f2ca03c-bfed-4738-839b-cc99710531d3",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "readr-assests"
		}
	]
}
