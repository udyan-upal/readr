# Web app environment
# Copy this file to .env.local and replace every placeholder.

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth service (apps/auth). Must be running for sign-in to work.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
# MUST byte-match apps/auth's JWT_ENCRYPTION_KEY — this app decrypts the
# access tokens that service mints. openssl rand -base64 32
JWT_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key=

# Text-to-speech uses Microsoft's public endpoint through msedge-tts.
# No TTS API key is required.
