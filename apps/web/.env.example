# Web app environment
# Copy this file to .env.local and replace every placeholder.

# Single-user login (POST /api/login). In production set these as Worker
# secrets (`wrangler secret put <NAME>`), not in a file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs the session JWT. openssl rand -base64 48
AUTH_SECRET=change-me-to-at-least-32-random-characters
# Static bearer token the browser extension uses for /api/tts. openssl rand -hex 32
# Must equal the extension's EDGE_TTS_API_TOKEN.
EXT_API_TOKEN=change-me

# PDFs live in R2 (bucket readr-assests) and notes/sessions in D1 (readr-db);
# both are Cloudflare bindings declared in wrangler.jsonc, not env vars.
# Text-to-speech uses Microsoft's public endpoint; no TTS API key is required.
