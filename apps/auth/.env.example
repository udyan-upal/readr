# openssl rand -base64 32  (must be >= 32 chars)
BETTER_AUTH_SECRET=change-me-to-a-32-plus-char-random-string
# openssl rand -base64 32  (must decode to exactly 32 bytes: dir + A256GCM JWE key)
JWT_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
# Browser origin allowed to call this service (the Next.js web app)
WEB_ORIGIN=http://localhost:3001
# --- Turso / libSQL (required) ---
# turso db show <db> --url
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# turso db tokens create <db>   (required for libsql:// and https:// URLs)
TURSO_AUTH_TOKEN=change-me-to-a-turso-database-token
# Local alternatives that need no token: file:./data/auth.db  or  :memory:

# --- OpenTelemetry (optional) ---
# Unset = telemetry off (tests + default dev). Set after `docker compose up`
# at the repo root; collector OTLP HTTP endpoint:
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_SERVICE_NAME=auth

# --- Logging (optional) ---
# debug | info (default) | warn | error
#LOG_LEVEL=info
# stdout (default) | otlp (ship logs to the collector -> Loki) | both
# otlp/both require OTEL_EXPORTER_OTLP_ENDPOINT
#LOG_MODE=stdout

